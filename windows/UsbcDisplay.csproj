<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UsbcDisplay</AssemblyName>
    <RootNamespace>UsbcDisplay</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The watcher is a separate .NET Framework program (build-watcher.cmd). -->
    <Compile Remove="watcher/**" />
    <!-- So is the setup app (setup/UsbcDisplaySetup.csproj, tools/build-windows.sh). -->
    <Compile Remove="setup/**" />
    <None Remove="setup/**" />
    <EmbeddedResource Remove="setup/**" />
  </ItemGroup>

</Project>
